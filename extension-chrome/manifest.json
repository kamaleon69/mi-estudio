{
  "manifest_version": 3,
  "name": "Mi Estudio · Sincronizar",
  "version": "1.9.1",
  "description": "Sincroniza Moodle y Classroom con Mi Estudio. Ayuda IA en Electude con autocompletado ON/OFF e intervalo configurable por respuesta.",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://moodle4.net.fje.edu/*",
    "https://classroom.google.com/*",
    "https://kamaleon69.github.io/*",
    "https://*.electude.eu/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kamaleon69.github.io/mi-estudio/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.electude.eu/*"
      ],
      "js": [
        "electude-core.js",
        "electude.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mi Estudio (en Electude: ayuda IA)",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
