{
  "manifest_version": 3,
  "name": "Mi Estudio · Sincronizar",
  "version": "1.9.1",
  "description": "Sincroniza Moodle y Classroom con Mi Estudio. Ayuda IA en Electude con autocompletado ON/OFF e intervalo configurable por respuesta.",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://moodle4.net.fje.edu/*",
    "https://classroom.google.com/*",
    "https://kamaleon69.github.io/*",
    "https://*.electude.eu/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://kamaleon69.github.io/mi-estudio/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.electude.eu/*"
      ],
      "js": [
        "electude-core.js",
        "electude.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mi Estudio (en Electude: ayuda IA)",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mi-estudio-sync@kamaleon69.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
